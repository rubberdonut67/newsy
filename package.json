{
  "name": "newsy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Continuously harvests news feeds across the internet and pushes an instant alert the moment an article matches one of your topics.",
  "author": "rubberdonut67",
  "homepage": "https://github.com/rubberdonut67/newsy",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/index.ts",
    "desktop": "electron desktop/main.js",
    "icons": "node scripts/gen-icon.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\" \"desktop/**/*.test.js\"",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.1.1",
    "fast-xml-parser": "^5.2.5",
    "fastify": "^5.3.2",
    "undici": "^8.10.1",
    "@ghostery/adblocker-electron": "^2.18.2"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.newsy.app",
    "productName": "Newsy",
    "copyright": "Newsy contributors",
    "asar": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "src/**",
      "public/**",
      "package.json",
      "!**/*.test.js",
      "!**/*.test.ts"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/newsy.ico",
      "executableName": "Newsy"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Newsy",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "Newsy-Setup-${version}.exe"
    }
  }
}
