# Copy to .env for local runs, or set these as secrets on your host.
# Everything here has a working default except NEWSY_PASSWORD, which you should
# set before exposing the dashboard to the internet.

# Which interfaces to answer on. 127.0.0.1 (the default) means this machine
# only; 0.0.0.0 means every device that can reach it. Use 0.0.0.0 on a server or
# to reach Newsy from your phone — and set NEWSY_PASSWORD when you do.
HOST=127.0.0.1

# Password gate for the dashboard and API. Empty = no auth (local use only).
NEWSY_PASSWORD=

# Public origin. Used for links inside notifications; leave empty locally.
PUBLIC_URL=

PORT=3000
DATA_DIR=./data
LOG_LEVEL=info

# Signs session cookies. Generated and persisted to DATA_DIR/secrets.json when
# unset. Set it explicitly if your host has no persistent volume — otherwise
# every redeploy signs everyone out.
SESSION_SECRET=

# Polling behaviour
TICK_MS=15000               # how often the scheduler looks for due feeds
POLL_CONCURRENCY=6          # feeds fetched at once
FEED_INTERVAL_SEC=300       # seconds between polls of a normal RSS feed
GNEWS_INTERVAL_SEC=180      # seconds between polls of a topic's Google News query
NOTIFY_MAX_AGE_HOURS=48     # older articles are stored but never alerted on
MAX_FEED_ERRORS=12          # consecutive failures before a feed is auto-disabled
RETENTION_DAYS=30           # unmatched articles are pruned after this long
MATCH_RETENTION_DAYS=182    # matched articles are pruned this long after their last match
